# =============================================================================
# Verifier VS — Configuration
# =============================================================================
#
# Operator-run verification service for the DPP Ecosystem (decision D8).
# Joins dpp-vs's Corporation as a delegated child. Holds VERIFIER on the DPP
# credential schema (OPEN onboarding) and checks passport presentations.
#
# For local testing:
#   source verifier-vs/config.env
#   ./verifier-vs/scripts/setup.sh
#
# =============================================================================

# NETWORK="devnet"

USER_ACC="dpp-vs-devnet-admin"
AGENT_ACC="verifier-vs-devnet-agent"

DPP_VS_PUBLIC_URL="${DPP_VS_PUBLIC_URL:-}"
DPP_VS_PUBLIC_URL="${DPP_VS_PUBLIC_URL%/}"
DPP_VS_PUBLIC_PORT="${DPP_VS_PUBLIC_PORT:-}"
DPP_VS_ADMIN_URL="${DPP_VS_ADMIN_URL:-http://localhost:3000}"
DPP_VS_ADMIN_URL="${DPP_VS_ADMIN_URL%/}"

VS_AGENT_IMAGE="${VS_AGENT_IMAGE:-veranalabs/vs-agent:v2.0.0-dev.97}"
VS_AGENT_CONTAINER_NAME="verifier-vs"
VS_AGENT_ADMIN_PORT="3012"
VS_AGENT_PUBLIC_PORT="3013"

SERVICE_NAME="DPP Verification Service (demo)"
SERVICE_TYPE="WEB_PORTAL"
SERVICE_DESCRIPTION="Verification service for the Digital Product Passport ecosystem"
SERVICE_LOGO_URI="https://verana.io/logo.svg"

CUSTOM_SCHEMA_BASE_ID="dpp"
