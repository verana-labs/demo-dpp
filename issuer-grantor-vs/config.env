# =============================================================================
# Issuer Grantor VS — Configuration
# =============================================================================
#
# Operator-run Issuer grantor for the DPP Ecosystem (decision D8).
# Joins dpp-vs's Corporation as a delegated child. Holds ISSUER_GRANTOR on the
# DPP credential schema and validates brand/third-party issuer onboarding.
#
# For local testing:
#   source issuer-grantor-vs/config.env
#   ./issuer-grantor-vs/scripts/setup.sh
#
# =============================================================================

# NETWORK="devnet"

# Corporation operator = dpp-vs operator (DPP_VS_MNEMONIC). Agent = this service.
USER_ACC="dpp-vs-devnet-admin"
AGENT_ACC="issuer-grantor-vs-devnet-agent"

# Parent: dpp-vs (ecosystem operator)
DPP_VS_PUBLIC_URL="${DPP_VS_PUBLIC_URL:-}"
DPP_VS_PUBLIC_URL="${DPP_VS_PUBLIC_URL%/}"
DPP_VS_PUBLIC_PORT="${DPP_VS_PUBLIC_PORT:-}"
DPP_VS_ADMIN_URL="${DPP_VS_ADMIN_URL:-http://localhost:3000}"
DPP_VS_ADMIN_URL="${DPP_VS_ADMIN_URL%/}"

VS_AGENT_IMAGE="${VS_AGENT_IMAGE:-veranalabs/vs-agent:v2.0.0-dev.97}"
VS_AGENT_CONTAINER_NAME="issuer-grantor-vs"
VS_AGENT_ADMIN_PORT="3010"
VS_AGENT_PUBLIC_PORT="3011"

SERVICE_NAME="DPP Issuer Grantor (demo)"
SERVICE_TYPE="WEB_PORTAL"
SERVICE_DESCRIPTION="Issuer grantor service for the Digital Product Passport ecosystem"
SERVICE_LOGO_URI="https://verana.io/logo.svg"

# Must match the schema published by dpp-vs
CUSTOM_SCHEMA_BASE_ID="dpp"
